# Neon PostgreSQL (https://neon.tech)
# 일반 연결 (마이그레이션용)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 풀링 연결 (앱 실행용 - pgbouncer)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="랜덤한-시크릿-키-생성-필요"
NEXTAUTH_URL="https://your-site.netlify.app"

# 관리자 계정 (초기 시드 시 사용)
ADMIN_EMAIL="admin@yoursite.com"
ADMIN_PASSWORD="강력한비밀번호!"

# 무통장 입금 정보
BANK_NAME="국민은행"
BANK_ACCOUNT="123-456-789012"
BANK_HOLDER="로또픽"

# 구독 금액
MONTHLY_FEE=9900
