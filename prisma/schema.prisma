generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum CreditType {
  CHARGE
  REFUND
  DEDUCT
  SUBSCRIPTION
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  password           String
  name               String
  phone              String?
  role               Role               @default(MEMBER)
  credits            Int                @default(0)
  subscriptionStatus SubscriptionStatus @default(PENDING)
  subscriptionExpiry DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments           Payment[]
  recommendedNumbers RecommendedNumber[]
  winningRecords     WinningRecord[]
  creditTransactions CreditTransaction[]
  subscriptions      Subscription[]

  @@map("users")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int
  status        PaymentStatus @default(PENDING)
  depositorName String
  bankRef       String?
  memo          String?
  confirmedAt   DateTime?
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription?

  @@map("payments")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  paymentId String?            @unique
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("subscriptions")
}

model LotteryDraw {
  id        String   @id @default(cuid())
  drawNo    Int      @unique
  drawDate  DateTime
  num1      Int
  num2      Int
  num3      Int
  num4      Int
  num5      Int
  num6      Int
  bonus     Int
  prize1    BigInt   @default(0)
  winners1  Int      @default(0)
  prize2    BigInt   @default(0)
  winners2  Int      @default(0)
  prize3    BigInt   @default(0)
  winners3  Int      @default(0)
  prize4    BigInt   @default(0)
  winners4  Int      @default(0)
  prize5    BigInt   @default(0)
  winners5  Int      @default(0)
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  winningRecords WinningRecord[]

  @@map("lottery_draws")
}

model RecommendedNumber {
  id        String    @id @default(cuid())
  userId    String
  drawNo    Int?
  num1      Int
  num2      Int
  num3      Int
  num4      Int
  num5      Int
  num6      Int
  method    String    @default("AI")
  sentAt    DateTime?
  isChecked Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  winningRecords WinningRecord[]

  @@map("recommended_numbers")
}

model WinningRecord {
  id                  String   @id @default(cuid())
  userId              String
  recommendedNumberId String
  drawNo              Int
  rank                Int?
  matchCount          Int
  bonusMatch          Boolean  @default(false)
  prize               BigInt   @default(0)
  isChecked           Boolean  @default(false)
  createdAt           DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id])
  recommendedNumber RecommendedNumber @relation(fields: [recommendedNumberId], references: [id])
  lotteryDraw       LotteryDraw       @relation(fields: [drawNo], references: [drawNo])

  @@map("winning_records")
}

model CreditTransaction {
  id          String     @id @default(cuid())
  userId      String
  amount      Int
  type        CreditType
  description String
  balance     Int
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("credit_transactions")
}

model AdminNotice {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_notices")
}
